{
  "name": "trackclassifier-shell",
  "version": "0.5.0",
  "private": true,
  "description": "Shell Electron do front React do TrackClassifier",
  "author": "Lucas Matricarde",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "smoke": "electron . --smoke",
    "test": "node --test updater.test.js",
    "pack": "electron-builder --dir",
    "dist": "electron-builder"
  },
  "devDependencies": {
    "electron": "^44.9.1",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.lucasmatricarde.trackclassifier",
    "productName": "TrackClassifier",
    "npmRebuild": false,
    "directories": {
      "output": "out"
    },
    "files": [
      "main.js",
      "preload.js",
      "updater.js",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../dist/TrackClassifier",
        "to": "backend"
      }
    ],
    "mac": {
      "category": "public.app-category.music",
      "icon": "../packaging/TrackClassifier.icns",
      "target": [
        "zip"
      ]
    },
    "win": {
      "target": [
        "zip"
      ]
    }
  }
}

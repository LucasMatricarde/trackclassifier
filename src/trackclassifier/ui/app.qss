/* Gerado por build_tokens.py a partir de design-tokens.json. Nao edite a mao. */

QWidget {
    background: #0B0E11;
    color: #E4EAF0;
    font-family: Space Grotesk, Inter, -apple-system, Segoe UI, Roboto, sans-serif;
    font-size: 12px;
}

QWidget#Sidebar, QWidget#PlayerBar {
    background: #13181D;
    border: none;
}

QLabel#SectionLabel {
    color: #5C6672;
    font-size: 11px;
    padding: 12px 8px 6px 8px;
}

QLabel#Hint {
    color: #5C6672;
    font-size: 11px;
}

QLabel#FieldError {
    color: #F0575C;
    font-size: 11px;
}

QLabel#TrackTitle { color: #E4EAF0; font-weight: 500; }
QLabel#TrackArtist { color: #9BA7B4; font-size: 11px; }
QLabel#Numeric { font-family: JetBrains Mono, SF Mono, Consolas, monospace; color: #E4EAF0; }
QLabel#KeyChip {
    font-family: JetBrains Mono, SF Mono, Consolas, monospace;
    color: #FFA582;
    background: #2E1509;
    border-radius: 3px;
    padding: 1px 6px;
}

QLineEdit {
    background: #1B222A;
    border: 1px solid rgba(255,255,255,0.10);
    border-radius: 3px;
    padding: 6px 8px;
    selection-background-color: #FF6B3D;
    selection-color: #0B0E11;
}
QLineEdit:focus { border-color: #FF6B3D; }
QLineEdit::placeholder { color: #5C6672; }

QPushButton {
    background: transparent;
    border: 1px solid rgba(255,255,255,0.10);
    border-radius: 3px;
    color: #E4EAF0;
    padding: 6px 12px;
    min-height: 28px;
}
QPushButton:hover { background: #1B222A; border-color: rgba(255,255,255,0.18); }
QPushButton:pressed { background: #242D37; }
QPushButton:disabled { color: #3E4650; border-color: rgba(255,255,255,0.05); }
QPushButton[variant="primary"] {
    background: #FF6B3D;
    border-color: #FF6B3D;
    color: #0B0E11;
}
QPushButton[variant="primary"]:hover { background: #FF8560; }
QPushButton[variant="ghost"] { border-color: transparent; }
QPushButton[variant="ghost"]:hover { background: #1B222A; }

QTableView, QTreeView, QListView {
    background: #0B0E11;
    alternate-background-color: #0B0E11;
    border: none;
    gridline-color: transparent;
    outline: none;
    selection-background-color: #1B222A;
    selection-color: #E4EAF0;
}
QTableView::item {
    border-bottom: 1px solid rgba(255,255,255,0.05);
    padding: 0px 8px;
}
QTableView::item:hover { background: #13181D; }

QHeaderView::section {
    background: #0B0E11;
    color: #5C6672;
    font-size: 11px;
    border: none;
    border-bottom: 1px solid rgba(255,255,255,0.10);
    padding: 6px 8px;
}

QScrollBar:vertical {
    background: transparent;
    width: 8px;
    margin: 0;
}
QScrollBar::handle:vertical {
    background: rgba(255,255,255,0.18);
    border-radius: 2px;
    min-height: 24px;
}
QScrollBar::add-line, QScrollBar::sub-line { height: 0; }
QScrollBar::add-page, QScrollBar::sub-page { background: transparent; }

QToolTip {
    background: #242D37;
    color: #E4EAF0;
    border: 1px solid rgba(255,255,255,0.10);
    border-radius: 3px;
    padding: 4px 8px;
}

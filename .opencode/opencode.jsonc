{
  "$schema": "https://opencode.ai/config.json",

  // `build` e o agente padrao: toolset completo (inclui `task`, que a skill
  // graphify usa) e nenhum agente customizado para manter.
  "default_agent": "build",

  // Compactacao explicita em vez de default implicito. O plugin
  // `opencode.config.compaction` le exatamente tres chaves -- `auto`, `buffer` e
  // `keep.tokens` -- e descarta o resto em silencio; `buffer` e IRMAO de `auto`,
  // nao campo dentro de `keep`.
  //
  // Gatilho automatico: `kx(contexto) >= Nm(limite, buffer)`. Sem `buffer`
  // explicito, `Nm = limite - max(10% do limite, 16000)` para limites acima de
  // 32k -- escala com o modelo, entao NAO pinar `buffer` aqui: num `k3` (1M) um
  // buffer fixo de 16000 subiria o gatilho para ~1.03M e sobrariam ~18k de folga
  // para a resposta, contra os ~105k que o default deixa.
  //
  // `keep.tokens` e o knob util: o default e 15000 e o checkpoint e reescrito
  // inteiro a cada compactacao, viajando em toda requisicao seguinte --
  // 15000 -> 6000 corta ~9k tokens por requisicao pos-compactacao, alem de
  // encurtar o resumo reescrito.
  //
  // Nao usar `auto: false`: ele desliga tambem a recuperacao de overflow (o
  // harness compacta e reenvia quando o provider recusa o payload), e ai uma
  // recusa vira falha dura do step em vez de degradar.
  //
  // E nao trocar de modelo no meio de uma cadeia de compactacao: o gatilho mede
  // pelo assistente mais recente do MESMO provider e o orcamento sai do limite
  // do modelo da sessao, entao trocar de modelo no meio reposiciona as duas
  // referencias. Foi o que embaralhou a cascata observada em 10-17, entre 23:51
  // e 00:05, quando a sessao passou de deepseek para ollama/qwen3:14b (40k).
  "compaction": {
    "auto": true,
    "keep": { "tokens": 6000 }
  },

  // Servidor MCP do grafo, com caminho RELATIVO ao repo: o OpenCode sobe o
  // servidor com cwd na raiz do projeto e o `graphify-mcp` abre o arquivo
  // relativo a ele. Assim o bloco e versionavel -- antes a config vivia no
  // `opencode.json` da raiz (nao rastreado) com path absoluto desta maquina, e
  // quem clonasse o repo ficava sem as tools (get_node, query_graph,
  // shortest_path) que a skill graphify-impacto usa.
  //
  // Requer `uv tool install graphifyy` (binario `graphify-mcp` no PATH) e o
  // grafo construido: `graphify update .`.
  "mcp": {
    "servers": {
      "graphify": {
        "type": "local",
        "command": ["graphify-mcp", "graphify-out/graph.json"]
      }
    }
  },

  // Allowlist, nao denylist. O OpenCode anuncia ID + nome + descricao de cada
  // skill permitida em TODO step, e o setup herdado tem 86 skills (~10.3k
  // tokens/req) das quais 85% sao design/frontend/animacao/office -- inuteis
  // aqui. `deny *` primeiro e os `allow` depois, porque a ultima regra que casa
  // vence. Consequencia: skill nova deste repo so aparece se for listada aqui.
  // Medido no fio (1 mensagem): o bloco <available_skills> custa
  // 6.196 B (~1.549 tok) por requisicao com 12 skills anunciadas -- so perde pro
  // prompt base do harness. Ficaram so as 6 skills deste repo + graphify (que o
  // usuario invoca por /graphify). As demais nao se usam aqui: find-skills,
  // domain-modeling, full-output-enforcement, grilling, grill-me, grill-with-docs.
  "permissions": [
    { "action": "skill", "resource": "*", "effect": "deny" },
    { "action": "skill", "resource": "trackclassifier", "effect": "allow" },
    { "action": "skill", "resource": "arquitetura", "effect": "allow" },
    { "action": "skill", "resource": "audio-features", "effect": "allow" },
    { "action": "skill", "resource": "apresentacao", "effect": "allow" },
    { "action": "skill", "resource": "concorrencia", "effect": "allow" },
    { "action": "skill", "resource": "empacotamento", "effect": "allow" },
    { "action": "skill", "resource": "ui", "effect": "allow" },
    { "action": "skill", "resource": "graphify", "effect": "allow" },
    // A receita de impacto de mudanca (affected -> explain -> ler citados) mora
    // no AGENTS.md, nao numa skill: medido em 18 runs, a skill carregada
    // custava +42% de tokens e piorava o acerto -- ter uma skill "graphify"
    // anunciada encorajava o agente a consultar o grafo justamente no caso em
    // que a politica manda nao consultar.

    // Superpowers: fluxo de desenvolvimento estruturado (brainstorming,
    // planejamento, TDD, debugging, code review, subagent-driven dev).
    // Permitidos após o deny *, senao o first-match-wins bloqueia tudo.
    { "action": "skill", "resource": "using-superpowers", "effect": "allow" },
    { "action": "skill", "resource": "brainstorming", "effect": "allow" },
    { "action": "skill", "resource": "writing-plans", "effect": "allow" },
    { "action": "skill", "resource": "executing-plans", "effect": "allow" },
    { "action": "skill", "resource": "subagent-driven-development", "effect": "allow" },
    { "action": "skill", "resource": "test-driven-development", "effect": "allow" },
    { "action": "skill", "resource": "systematic-debugging", "effect": "allow" },
    { "action": "skill", "resource": "verification-before-completion", "effect": "allow" },
    { "action": "skill", "resource": "diagnosing-superpowers", "effect": "allow" },
    { "action": "skill", "resource": "dispatching-parallel-agents", "effect": "allow" },
    { "action": "skill", "resource": "requesting-code-review", "effect": "allow" },
    { "action": "skill", "resource": "receiving-code-review", "effect": "allow" },
    { "action": "skill", "resource": "using-git-worktrees", "effect": "allow" },
    { "action": "skill", "resource": "finishing-a-development-branch", "effect": "allow" },
    { "action": "skill", "resource": "writing-skills", "effect": "allow" }
  ]
}
